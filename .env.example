# Copy this file to .env and fill in your values. .env is gitignored.
# Consumed at build time by scripts/generate_secrets.sh, which injects the
# values into the compiled app via EmGestPro/App/PatreonSecrets.swift.

# Patreon v2 OAuth client credentials (create the client at
# https://www.patreon.com/portal/registration/register-clients while signed in
# with your creator account). Without them the paywall sign-in is disabled.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

# Patreon account email of the EmAppleFlagship campaign owner. Signing in with
# this account automatically unlocks EmGestPro Ultra, no membership check.
PATREON_OWNER_EMAIL=